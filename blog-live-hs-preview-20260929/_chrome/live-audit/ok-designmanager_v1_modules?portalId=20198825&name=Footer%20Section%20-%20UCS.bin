{"limit":100,"objects":[{"assetSource":"MYSQL","author":"js@ucspa.com","authorAt":1790683322476,"breakpointFitFillConfig":{},"breakpointSpanningConfig":{},"categories":[],"containsOverridableHublTags":true,"contentTags":[],"contentTypes":["QUOTE_TEMPLATE","LANDING_PAGE","SITE_PAGE","BLOG_LISTING","BLOG_POST"],"created":1626171473641,"createdById":8912875,"css":"","cssAssets":[],"cssRenderOptions":null,"default":false,"deleted":false,"deletedAt":0,"deployId":1,"displayName":"Footer Section - UCS","editableContexts":[],"externalJs":[],"extraClasses":"","fields":[{"default":{"size_type":"auto","src":"https://f.hubspotusercontent20.net/hubfs/20198825/Home%20Page/UCS-Logo.png","alt":"UCS-Logo","loading":"lazy","width":338,"height":32,"max_width":338,"max_height":32},"display_width":null,"id":"094a5c84-31c5-25d9-18aa-0b688c938650","label":"Logo","locked":true,"name":"logo","required":false,"resizable":true,"responsive":true,"show_loading":false,"type":"image"},{"default":{"url":{"content_id":null,"type":"EXTERNAL","href":""},"open_in_new_tab":false,"no_follow":false},"display_width":null,"id":"f1f91794-57b8-85bd-8c81-d01ee4c86241","label":"Logo Link","locked":true,"name":"logo_link","required":false,"show_advanced_rel_options":false,"supported_types":["EXTERNAL","CONTENT","FILE","EMAIL_ADDRESS","BLOG"],"type":"link"},{"default":"<p><span>We are helping homeowners, property managers and contractors file property damage claims, get higher settlements and eliminate the headaches of dealing with insurance claims.&nbsp;</span></p>","display_width":null,"id":"138f0009-87e0-390f-1218-94a2357377dc","label":"Text","locked":true,"name":"text","required":false,"type":"richtext"},{"children":[{"allow_new_line":false,"display_width":null,"id":"8f7fbf42-83b5-4614-0d9f-b52e23015b3e","label":"Menu  Title","locked":false,"name":"menu_title","required":false,"type":"text"},{"default":"<ul>\n<li><a> Book Your Sleep Study </a></li>\n<li><a> Self Assessment </a></li>\n<li><a> Patient Feedback </a></li>\n<li><a> About Us </a></li>\n</ul>","display_width":null,"id":"f161b67b-e675-dacb-acfa-01390aa42ccc","label":"Menu Text","locked":false,"name":"menu_text","required":false,"type":"richtext"}],"default":{"menu_text":"<ul>\n<li><a> Book Your Sleep Study </a></li>\n<li><a> Self Assessment </a></li>\n<li><a> Patient Feedback </a></li>\n<li><a> About Us </a></li>\n</ul>"},"display_width":null,"expanded":false,"group_occurrence_meta":null,"id":"fe1297c2-60ca-5fcc-d374-a5efdd51f64f","label":"Menu Group","locked":true,"name":"menu_group","occurrence":{},"required":false,"tab":"CONTENT","type":"group"},{"allow_new_line":false,"default":"Schedule damage assessment","display_width":null,"id":"9154965c-54dc-771b-1020-0de1b088e91a","label":"Form Title","locked":true,"name":"form_title","required":false,"type":"text"},{"default":{"form_id":"a7842cf4-7a68-4360-80aa-23a50295c8d6","response_type":"inline","message":"Thanks for submitting the form.","gotowebinar_webinar_key":null,"form_type":"HUBSPOT"},"display_width":null,"id":"86b4562b-dec2-90c8-4f2b-63b5ea1e00e3","label":"Footer Form","locked":true,"name":"footer_form","required":false,"type":"form"},{"children":[{"default":{"url":{"content_id":null,"type":"EXTERNAL","href":""},"open_in_new_tab":false,"no_follow":false},"display_width":null,"id":"45e33d37-9341-6cf3-fdb4-c75ddd8b7e05","label":"Icon Link","locked":false,"name":"icon_link","required":false,"show_advanced_rel_options":false,"supported_types":["EXTERNAL","CONTENT","FILE","EMAIL_ADDRESS","BLOG"],"type":"link"},{"default":{"name":"Facebook F","unicode":"f39e","type":"REGULAR"},"display_width":null,"icon_set":"fontawesome-5.14.0","id":"2d8f0656-01b3-a09a-9bb2-5b1efb8f593f","label":"Icon","locked":false,"name":"icon_field","required":false,"type":"icon"}],"default":{"icon_link":{"url":{"content_id":null,"type":"EXTERNAL","href":""},"open_in_new_tab":false,"no_follow":false},"icon_field":{"name":"Facebook F","unicode":"f39e","type":"REGULAR"}},"display_width":null,"expanded":false,"group_occurrence_meta":null,"id":"807c244e-e982-2de5-b780-ec0cc120a8d8","label":"Social Icon Group","locked":true,"name":"social_icon_group","occurrence":{},"required":false,"tab":"CONTENT","type":"group"},{"default":"<ul>\n<li><a> Privacy policy. </a></li>\n<li><a> Terms of use. </a></li>\n</ul>","display_width":null,"id":"b42bf206-2e29-0150-e99f-2b40c619b1a0","label":"CopyRight List","locked":true,"name":"copyright_list","required":false,"type":"richtext"},{"default":"<p>© 2013-2021 United Claims Specialists. All Rights Reserved</p>","display_width":null,"id":"7588d1ce-5260-f154-36c2-74a4c5756145","label":"CopyRight Text","locked":true,"name":"copyright_text","required":false,"type":"richtext"}],"filename":"Footer Section - UCS","folderId":50485802168,"folderPath":"United Claims Specialists/Custom Modules","gates":[],"global":true,"hasAnyCss":false,"hasAnyJs":false,"hasGlobalContent":true,"hostTemplateTypes":["PAGE","BLOG_POST","BLOG_LISTING","QUOTE"],"id":50694621511,"inheritedAsset":false,"inlineHelpText":"","isAvailableForNewContent":true,"isBuffered":false,"isEnabledForEmailV3Rendering":null,"isJsModule":false,"isReplicatorModule":null,"isThemeAsset":false,"jsAssets":[],"jsRenderOptions":null,"label":"Footer Section - UCS","messages":{},"moduleId":50694621511,"name":"Footer Section - UCS","otherAssets":[],"path":"/United Claims Specialists/Custom Modules/Footer Section - UCS","placeholder":null,"portalId":20198825,"previewKey":"bhf_pacIrDj4DQbUVRI2Zg","purchased":false,"reactBuildMeta":null,"replicatorWorkspaceId":null,"requiresMarketplaceJQuery":false,"schemaVersion":2,"scopes":[],"searchTerms":[],"skipValidationForContentSync":false,"smartType":"NOT_SMART","source":"<div class=\"Footer-Section top-curv fullwidth\">\n  <div class=\"wrapper\">\n    <div class=\"Footer-Outer fullwidth\">\n      <div class=\"Footer-Row fullwidth\">\n        <div class=\"Footer-Row-Left fur-col-footer\">\n          <div class=\"Footer-Logo\">\n            {% set href = module.logo_link.url.href %}\n            {% if module.logo_link.url.type is equalto \"EMAIL_ADDRESS\" %}\n            {% set href = \"mailto:\" + href %}\n            {% endif %}\n            {% set rel = [] %}\n            {% if module.logo_link.no_follow %}\n            {% do rel.append(\"nofollow\") %}\n            {% endif %}\n            {% if module.logo_link.open_in_new_tab %}\n            {% do rel.append(\"noopener\") %}\n            {% endif %}\n            <a href=\"{{ href }}\"\n              {% if module.logo_link.open_in_new_tab %}target=\"_blank\"{% endif %}\n              {% if rel %}rel=\"{{ rel|join(\" \") }}\"{% endif %}\n              >\n              {% if module.logo.src %}\n              {% set sizeAttrs = 'width=\"{{ module.logo.width }}\" height=\"{{ module.logo.height }}\"' %}\n              {% if module.logo.size_type == 'auto' %}\n              {% set sizeAttrs = 'style=\"max-width: 100%; height: auto;\"' %}\n              {% elif module.logo.size_type == 'auto_custom_max' %}\n              {% set sizeAttrs = 'width=\"{{ module.logo.max_width }}\" height=\"{{ module.logo.max_height }}\" style=\"max-width: 100%; height: auto;\"' %}\n              {% endif %}\n              {% set loadingAttr = module.logo.loading != 'disabled' ? 'loading=\"{{ module.logo.loading }}\"' : '' %}\n              <img src=\"{{ module.logo.src }}\" alt=\"{{ module.logo.alt }}\" {{ loadingAttr }} {{ sizeAttrs }}>\n              {% endif %}\n            </a>\n          </div>\n          <div class=\"Footer-Lft-text\">\n            {{ module.text }}\n          </div>\n        </div> \n        <div class=\"Footer-Row-center fur-col-footer\">\n          {% for item in module.menu_group %}\n          {% if loop.index == 1 %}\n          <div class=\"Footer-Menu-Col\">\n            <h6>\n              {{ item.menu_title }}\n            </h6>\n            <div class=\"Footer-Menu\">\n              {{ item.menu_text }}\n            </div>\n          </div>\n          {% endif %}\n          {% endfor %}\n        </div>\n        <div class=\"Footer-Row-menu fur-col-footer\">\n          {% for item in module.menu_group %}\n          {% if loop.index > 1 %}\n          <div class=\"Footer-Menu-Col\">\n            <h6>\n              {{ item.menu_title }}\n            </h6>\n            <div class=\"Footer-Menu\">\n              {{ item.menu_text }}\n            </div>\n          </div>\n           {% endif %}\n          {% endfor %}\n        </div>\n        <div class=\"Footer-Row-right fur-col-footer\">\n          <h6> Schedule damage assessment </h6>\n          <div class=\"Footer-Row-Form\">\n            {% form\n              form_to_use=\"{{ module.footer_form.form_id }}\"\n              response_response_type=\"{{ module.footer_form.response_type }}\"\n              response_message=\"{{ module.footer_form.message }}\"\n              response_redirect_id=\"{{ module.footer_form.redirect_id }}\"\n              response_redirect_url=\"{{module.footer_form.redirect_url}}\"\n              gotowebinar_webinar_key=\"{{ module.footer_form.gotowebinar_webinar_key }}\"\n            %}\n          </div>\n          <div class=\"Footer-Row-Icons\">\n            <ul>\n              {% for item in module.social_icon_group %}\n            <li>\n              {% set href = item.icon_link.url.href %}\n              {% if item.icon_link.url.type is equalto \"EMAIL_ADDRESS\" %}\n              {% set href = \"mailto:\" + href %}\n              {% endif %}\n              {% set rel = [] %}\n              {% if item.icon_link.no_follow %}\n              {% do rel.append(\"nofollow\") %}\n              {% endif %}\n              {% if item.icon_link.open_in_new_tab %}\n              {% do rel.append(\"noopener\") %}\n              {% endif %}\n              <a href=\"{{ href }}\"\n                {% if item.icon_link.open_in_new_tab %}target=\"_blank\"{% endif %}\n                {% if rel %}rel=\"{{ rel|join(\" \") }}\"{% endif %}\n                >\n                {% icon\n                  name=\"{{ item.icon_field.name }}\"\n                  style=\"{{ item.icon_field.type }}\"\n                  unicode=\"{{ item.icon_field.unicode }}\"\n                  icon_set=\"{{ item.icon_field.icon_set }}\"\n                %}\n              </a>\n              </li>\n              {% endfor %}\n            </ul>\n          </div>\n        </div>\n      </div>\n      <div class=\"Footer-copyright fullwidth\">\n        <div class=\"Footer-copyright-left\">\n          {{ module.copyright_list }}\n        </div>\n        <div class=\"Footer-copyright-right\">\n          {{ module.copyright_text }}\n        </div>\n      </div>\n    </div>\n  </div>\n</div>","sourceContainsPostBody":false,"staged":false,"tags":[],"toolbarFields":{},"updated":1790683322476,"updatedById":25070484,"widgetLabel":"","writeable":true}],"offset":0,"total":1,"totalCount":1}