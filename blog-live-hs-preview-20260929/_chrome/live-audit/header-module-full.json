  "source": "<div class=\"Header-Section fullwidth\">\n\t<div class=\"Header-Top-Section fullwidth\" style=\"background-color: rgba(152, 204, 0 , 100% );\">\n\t\t<div class=\"wrapper\">\n\t\t\t<div class=\"Header-Top-Inner flexwrap alignCenter\">\n\t\t\t\t<div class=\"Header-Top-Left\">\n\t\t\t\t  {{ module.left_text }}\n\t\t\t\t</div>\n\t\t\t\t<div class=\"Header-Top-Right\">\n\t\t\t\t\t<ul>\n            {% for item in module.icon_group %}\n            <li>\n            {% set href = item.icon_link.url.href %}\n            {% if item.icon_link.url.type is equalto \"EMAIL_ADDRESS\" %}\n            {% set href = \"mailto:\" + href %}\n            {% endif %}\n            {% set rel = [] %}\n            {% if item.icon_link.no_follow %}\n            {% do rel.append(\"nofollow\") %}\n            {% endif %}\n            {% if item.icon_link.open_in_new_tab %}\n            {% do rel.append(\"noopener\") %}\n            {% endif %}\n            <a href=\"{{ href }}\"\n              {% if item.icon_link.open_in_new_tab %}target=\"_blank\"{% endif %}\n              {% if rel %}rel=\"{{ rel|join(\" \") }}\"{% endif %}\n              >\n              {% if item.social_media_icon.src %}\n              {% set sizeAttrs = 'width=\"{{ item.social_media_icon.width }}\" height=\"{{ item.social_media_icon.height }}\"' %}\n              {% if item.social_media_icon.size_type == 'auto' %}\n              {% set sizeAttrs = 'style=\"max-width: 100%; height: auto;\"' %}\n              {% elif item.social_media_icon.size_type == 'auto_custom_max' %}\n              {% set sizeAttrs = 'width=\"{{ item.social_media_icon.max_width }}\" height=\"{{ item.social_media_icon.max_height }}\" style=\"max-width: 100%; height: auto;\"' %}\n              {% endif %}\n              {% set loadingAttr = item.social_media_icon.loading != 'disabled' ? 'loading=\"{{ item.social_media_icon.loading }}\"' : '' %}\n              <img src=\"{{ item.social_media_icon.src }}\" alt=\"{{ item.social_media_icon.alt }}\" {{ loadingAttr }} {{ sizeAttrs }}>\n              {% endif %}\n            </a>\n            </li>\n            {% endfor %}\n          </ul>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class=\"Header-Main-Section fullwidth\">\n\t\t<div class=\"wrapper\">\n\t\t\t<div class=\"Header-Main-Inner flexwrap alignCenter\">\n\t\t\t\t<div class=\"Header-Main-Logo\">\n\t\t\t\t\t{% set href = module.logo_link.url.href %}\n          {% if module.logo_link.url.type is equalto \"EMAIL_ADDRESS\" %}\n          {% set href = \"mailto:\" + href %}\n          {% endif %}\n          {% set rel = [] %}\n          {% if module.logo_link.no_follow %}\n          {% do rel.append(\"nofollow\") %}\n          {% endif %}\n          {% if module.logo_link.open_in_new_tab %}\n          {% do rel.append(\"noopener\") %}\n          {% endif %}\n          <a href=\"{{ href }}\"\n            {% if module.logo_link.open_in_new_tab %}target=\"_blank\"{% endif %}\n            {% if rel %}rel=\"{{ rel|join(\" \") }}\"{% endif %}\n            >\n            {% if module.logo.src %}\n            {% set sizeAttrs = 'width=\"{{ module.logo.width }}\" height=\"{{ module.logo.height }}\"' %}\n            {% if module.logo.size_type == 'auto' %}\n            {% set sizeAttrs = 'style=\"max-width: 100%; height: auto;\"' %}\n            {% elif module.logo.size_type == 'auto_custom_max' %}\n            {% set sizeAttrs = 'width=\"{{ module.logo.max_width }}\" height=\"{{ module.logo.max_height }}\" style=\"max-width: 100%; height: auto;\"' %}\n            {% endif %}\n            {% set loadingAttr = module.logo.loading != 'disabled' ? 'loading=\"{{ module.logo.loading }}\"' : '' %}\n            <img src=\"{{ module.logo.src }}\" alt=\"{{ module.logo.alt }}\" {{ loadingAttr }} {{ sizeAttrs }}>\n            {% endif %}\n          </a>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"Header-Main-Menu custom-menu-primary\">\n          <div class=\"Header-Main-Menu-inner fullwidth\">\n            <div class=\"Header-Menu\">\n              {% menu id=\"{{ module.menu_field }}\" %}\n            </div>\n            <div class=\"Header-main-CTA\">\n\t\t\t\t\t\t\t{% set href = module.cta_link.url.href %}\n              {% if module.cta_link.url.type is equalto \"EMAIL_ADDRESS\" %}\n              {% set href = \"mailto:\" + href %}\n              {% endif %}\n              {% set rel = [] %}\n              {% if module.cta_link.no_follow %}\n              {% do rel.append(\"nofollow\") %}\n              {% endif %}\n              {% if module.cta_link.open_in_new_tab %}\n              {% do rel.append(\"noopener\") %}\n              {% endif %}\n              <a href=\"{{ href }}\"\n                {% if module.cta_link.open_in_new_tab %}target=\"_blank\"{% endif %}\n                {% if rel %}rel=\"{{ rel|join(\" \") }}\"{% endif %}\n                >\n                {{ module.cta_text }}\n              </a>\n\t\t\t\t\t</div>\n          </div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>",
